DATABASE_URL=postgresql+asyncpg://qa360:qa360pass@db:5432/qa360
SYNC_DATABASE_URL=postgresql://qa360:qa360pass@db:5432/qa360
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ANTHROPIC_API_KEY=sk-ant-...
AWS_REGION=us-east-1
AWS_S3_BUCKET=access-qa-360-screenshots
ENVIRONMENT=development
# Comma-separated emails that become super admin on register or sign-in
SUPER_ADMIN_EMAILS=
# Folder for uploaded builds and generated reports (keep it on a persistent volume)
STORAGE_DIR=storage
# Largest .apk or .ipa upload, in MB
MAX_UPLOAD_MB=300
# Largest amount of source code, once unpacked, that one code scan reads
CODE_SCAN_MAX_MB=500

# Address of the web app, used in links inside emails and password reset links
APP_URL=http://localhost:5173
# Outgoing email for password resets and invitations. Leave SMTP_HOST empty to send none;
# reset links are then created by a super admin and invite links are copied by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_MINUTES=60

# ---- Plans and billing. The amounts are placeholders: change them before charging anyone. ----
# Team plan, per person per month: whole US dollars (Stripe) and whole rupees (Razorpay)
TEAM_PRICE_USD=29
TEAM_PRICE_INR=2400
# Scans a free Individual account may start each month (new sign-ups only). 0 means no limit.
FREE_SCANS_PER_MONTH=2
# Shown on the pricing page for Enterprise
SALES_EMAIL=
# Stripe (US dollars). Webhook address: APP_URL/api/v1/billing/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay (rupees). Webhook address: APP_URL/api/v1/billing/webhooks/razorpay
# Events: subscription.activated, subscription.charged, subscription.pending, subscription.halted, subscription.cancelled, subscription.completed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Sign in with Google. Leave the client id empty to switch it off. ----
# In each provider's console, register this redirect address: APP_URL/api/v1/auth/sso/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only when the API is not reached through APP_URL/api/v1 (for local development: http://localhost:8000/api/v1)
SSO_REDIRECT_BASE=
