DATABASE_URL=postgresql+asyncpg://qa360:qa360pass@db:5432/qa360
SYNC_DATABASE_URL=postgresql://qa360:qa360pass@db:5432/qa360
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ANTHROPIC_API_KEY=sk-ant-...
AWS_REGION=us-east-1
AWS_S3_BUCKET=access-qa-360-screenshots
ENVIRONMENT=development
# Comma-separated emails that become super admin on register or sign-in
SUPER_ADMIN_EMAILS=
# Folder for uploaded builds and generated reports (keep it on a persistent volume)
STORAGE_DIR=storage
# Largest .apk or .ipa upload, in MB
MAX_UPLOAD_MB=300
# Largest amount of source code, once unpacked, that one code scan reads
CODE_SCAN_MAX_MB=500
