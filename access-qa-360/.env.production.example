# Copy to .env.production and fill in. Never commit the filled-in file.

# ---- Required -------------------------------------------------------------
# Public address of the app, no trailing slash. Used in emailed links.
APP_URL=https://qa.example.com
# Domain only, for the optional built-in HTTPS (./deploy.sh --tls)
DOMAIN=qa.example.com

# Database. Use a long random password; the two URLs must match it.
POSTGRES_USER=wiseflow
POSTGRES_PASSWORD=
POSTGRES_DB=wiseflow
DATABASE_URL=postgresql+asyncpg://wiseflow:PASSWORD@db:5432/wiseflow
SYNC_DATABASE_URL=postgresql://wiseflow:PASSWORD@db:5432/wiseflow
REDIS_URL=redis://redis:6379/0

# Signs sign-in tokens. Generate with:  openssl rand -hex 32
SECRET_KEY=
# Writes test cases, automation scripts and report summaries
ANTHROPIC_API_KEY=
# Emails that become super admin when they sign up or sign in (comma-separated)
SUPER_ADMIN_EMAILS=

ENVIRONMENT=production
CORS_ORIGINS=https://qa.example.com

# ---- Optional -------------------------------------------------------------
# Port the app listens on when HTTPS is handled elsewhere (Dokploy, a load balancer)
WEB_PORT=8080

# Email for password resets and invitations. Leave SMTP_HOST empty to send none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Uploads and reports are kept in the "storage" volume
STORAGE_DIR=storage
MAX_UPLOAD_MB=300
CODE_SCAN_MAX_MB=500
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_MINUTES=60

# ---- Plans and billing. The amounts are placeholders: change them before charging anyone. ----
# Team plan, per person per month: whole US dollars (Stripe) and whole rupees (Razorpay)
TEAM_PRICE_USD=29
TEAM_PRICE_INR=2400
# Scans a free Individual account may start each month (new sign-ups only). 0 means no limit.
FREE_SCANS_PER_MONTH=10
# Shown on the pricing page for Enterprise
SALES_EMAIL=
# Stripe (US dollars). Webhook address: APP_URL/api/v1/billing/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay (rupees). Webhook address: APP_URL/api/v1/billing/webhooks/razorpay
# Events: subscription.activated, subscription.charged, subscription.pending, subscription.halted, subscription.cancelled, subscription.completed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
